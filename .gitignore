# =============================================================================
# Git に上げないファイルの一覧
#
# ここに書いたファイルは、GitHubに送られません。
# APIキーなどの秘密情報を、うっかり公開してしまう事故を防ぐためのものです。
# =============================================================================

# 秘密情報
.env
.env.*
*.key
secrets.json

# パソコンが勝手に作るファイル
.DS_Store
Thumbs.db
desktop.ini

# エディタの設定
.vscode/
.idea/

# 部品置き場（今回は使いませんが、将来のために）
node_modules/

# 動作確認で書き出したデータ（実在の個人情報が入る可能性があるため）
organization-knowledge-*.json
